---
import { Image } from 'astro:assets';
import Analytics from '@vercel/analytics/astro';
import '../styles/global.css'

import lmcLogo from '../assets/img/lmc_logo.jpg';
import ffeLogo from '../assets/img/ffe_logo.jpg';
import hautsDeFranceLogo from '../assets/img/hautdefrance_logo.png';
import departementNordLogo from '../assets/img/departement_nord_logo.jpg';
import villeDeLilleLogo from '../assets/img/villedelille_logo.jpg';

export interface Props {
	title: string;
}

const { title } = Astro.props;

const footerLogos = [
	{ src: lmcLogo, alt: 'Lille Métropole Chess' },
	{ src: ffeLogo, alt: 'Fédération Française des Échecs' },
	{ src: hautsDeFranceLogo, alt: 'Région Hauts-de-France' },
	{ src: departementNordLogo, alt: 'Département du Nord' },
	{ src: villeDeLilleLogo, alt: 'Ville de Lille' },
];
---

<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Astro description">
		<meta name="viewport" content="width=device-width" />
			<link rel="icon" type="image/jpeg" href={lmcLogo.src}>
			<!-- <link rel="icon" type="image/svg+xml" href="/favicon.svg" /> -->
			<link rel="preconnect" href="https://fonts.googleapis.com">
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
			<link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;700&family=Playfair+Display:wght@400;700&display=swap" rel="stylesheet">
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		
	</head>
		<body class="site">
			<header class="site-header">
				
				<div class="site-brand">
					<a class="site-logo" href="/"><Image class="hero-logo" src={lmcLogo} alt="" width={136} /></a>
					<a class="site-logo" href="/">Lille Métropole Chess</a>
				</div>

				<nav class="main-nav">
					<a href="/">Accueil</a>
					<a href="/club">Le Club</a>
					<a href="/events">Évènements</a>
					<a href="/contact">Contact</a>
					<span class="nav-pending">Blog<span class="nav-pending-tag">bientôt</span></span>
					<a href="https://www.helloasso.com/associations/lille-metropole-chess" target="_blank" rel="noopener noreferrer">Boutique</a>
				</nav>
				<details class="mobile-menu">
					<summary>Menu</summary>
					<nav>
						<a href="/">Accueil</a>
						<a href="/club">Le Club</a>
						<a href="/events">Évènements</a>
						<a href="/contact">Contact</a>
						<span class="nav-pending">Blog<span class="nav-pending-tag">bientôt</span></span>
						<a href="https://www.helloasso.com/associations/lille-metropole-chess" target="_blank" rel="noopener noreferrer">Boutique</a>
					</nav>
				</details>
			</header>
			<main class="page">
				<slot />
			</main>

			<footer class="site-footer">
				<div class="footer-logos">
					{footerLogos.map((logo) => (
						<Image src={logo.src} alt={logo.alt} width={180} loading="lazy" />
					))}
				</div>
				<p>©Gia-Thuy Pham | Nicolas Seynaeve | LMC 2026</p>
			</footer>
			<Analytics />
		</body>
</html>

---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const chessTours = await getCollection('chessTours');
export const prerender = true;
---

<Layout title="Lille Métropole Chess">
  <div class="hero">
    <div class="hero-header">
      <h1>Bienvenue au LMC</h1>
    </div>

    <div class="columns">
      <div class="col">
        <ul>
          <li id="club">
            <a href="/club" ><strong>Le Club</strong></a>
            <ul>
              <li><a href="/contact" >Contact/S'y rendre</a></li>
              <li><a href="/inscription" >Inscription</a></li>
              <li>Nos partenaires</li>
            </ul>
          </li>

          <li id="teams">
            <a href="/teams" ><strong>Nos équipes</strong></a>
          </li>

          <li id="tour">
            <a href="/chess-tours" ><strong>Lille Métropole Chess Tour</strong></a>
            <ul>
              {chessTours.map(tour => (
                <li>
                  <a href={`/chess-tours/${tour.id}`}>{tour.data.title}</a>
                </li>
              ))}
            </ul>
          </li>
        </ul>
      </div>

      <div class="col">
        <ul>
          <li id="beginner">
            <strong>Débuter aux échecs</strong>
            <ul>
              <li>Le guide de la compétition</li>
              <li><a href="https://drive.google.com/drive/u/0/folders/1xSvnu9TUJ8HJfWn86HZLvtggFEAnhCIh" target="_blank" rel="noopener noreferrer">Ressources pédagogiques</a></li>
            </ul>
          </li>

          <li id="blog">
            <strong>Blog</strong>
            <ul>
              <li>Le LMC en compétition</li>
              <li>Histoires des échecs</li>
            </ul>
          </li>

          <li id="shop"> <a href="https://www.helloasso.com/associations/lille-metropole-chess/boutiques/textiles-lmc" target="_blank" rel="noopener noreferrer"> <strong>Boutique</strong></a></li>
        </ul>
      </div>
    </div>
  </div>
</Layout>

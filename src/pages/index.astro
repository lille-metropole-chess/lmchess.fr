---
import Layout from '../layouts/Layout.astro';

export const prerender = true;
---

<Layout title="Keystatic & Astro's Content Collections">
  <div class="hero">
    <div class="hero-header">
      <img class="hero-logo" src="/img/lmc_logo.jpg" alt="LMC logo" />
      <h1>Le site internet du LMC</h1>
    </div>

    <div class="columns">
      <div class="col">
        <ul>
          <li>
            Le Club
            <ul>
              <li>S’y rendre</li>
              <li>Inscription</li>
              <li>Nos partenaires</li>
            </ul>
          </li>

          <li>
            Nos équipes
            <ul>
              <li>Interclubs</li>
              <li>Coupe Loubatière</li>
              <li>Coupe de la Parité</li>
              <li>Coupe de France</li>
            </ul>
          </li>

          <li>
            Lille&nbsp;Métropole&nbsp;Chess&nbsp;Tour
            <ul>
              <li>Edition 26-27</li>
              <li>Edition 27-28...</li>
            </ul>
          </li>
        </ul>
      </div>

      <div class="col">
        <ul>
          <li>
            Débuter aux échecs
            <ul>
              <li>Ressources pédagogiques</li>
              <li>Le guide de la compétition</li>
            </ul>
          </li>

          <li>
            Blog
            <ul>
              <li>Le LMC en compétition</li>
              <li>Histoires des échecs</li>
            </ul>
          </li>

          <li>Boutique</li>
        </ul>
      </div>
    </div>
  </div>
</Layout>

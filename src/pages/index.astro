---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const chessTours = await getCollection('chessTours');
export const prerender = true;
---

<Layout title="Keystatic & Astro's Content Collections">
  <div class="hero">
    <div class="hero-header">
      <img class="hero-logo" src="/img/lmc_logo.jpg" alt="LMC logo" />
      <h1>Bienvenue au LMC</h1>
    </div>

    <div class="columns">
      <div class="col">
        <ul>
          <li id="club">
            Le Club
            <ul>
              <li>S’y rendre</li>
              <li>Inscription</li>
              <li>Nos partenaires</li>
            </ul>
          </li>

          <li id="teams">
            Nos équipes
            <ul>
              <li>Interclubs</li>
              <li>Coupe Loubatière</li>
              <li>Coupe de la Parité</li>
              <li>Coupe de France</li>
            </ul>
          </li>

          <li id="tour">
            Lille&nbsp;Métropole&nbsp;Chess&nbsp;Tour
            <ul>
              {chessTours.map(tour => (
                <li>
                  <a href={`/chess-tours/${tour.id}`}>{tour.data.title}</a>
                </li>
              ))}
            </ul>
          </li>
        </ul>
      </div>

      <div class="col">
        <ul>
          <li id="beginner">
            Débuter aux échecs
            <ul>
              <li><a href="https://drive.google.com/drive/u/0/folders/1xSvnu9TUJ8HJfWn86HZLvtggFEAnhCIh" target="_blank" rel="noopener noreferrer">Ressources pédagogiques</a></li>
              <li>Le guide de la compétition</li>
            </ul>
          </li>

          <li id="blog">
            Blog
            <ul>
              <li>Le LMC en compétition</li>
              <li>Histoires des échecs</li>
            </ul>
          </li>

          <li id="shop"> <a href="https://www.helloasso.com/associations/lille-metropole-chess/boutiques/textiles-lmc">Boutique</a></li>
        </ul>
      </div>
    </div>
  </div>
</Layout>

---
import { getCollection, getEntry, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export const prerender = true;

const { slug } = Astro.params;
if (!slug) throw new Error('Slug not found');
const tour = await getEntry('chessTours', slug);

if (!tour) throw new Error('No chess tour found for this slug');
const { Content } = await render(tour);

export async function getStaticPaths() {
  const chessTours = await getCollection('chessTours');
  return chessTours.map(tour => ({ params: { slug: tour.id } }));
}
---

<Layout title={tour.data.title}>
  <h1 style="text-align: center; font-size: clamp(2rem, 6vw, 4rem); font-weight: 400;">{tour.data.title}</h1>
  <div class="prose"><Content /></div>
</Layout>

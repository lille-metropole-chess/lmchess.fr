---
import { getCollection, getEntries, getEntry, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import TournamentTable from '../../components/TournamentTable.astro';

export const prerender = true;

const { slug } = Astro.params;
if (!slug) throw new Error('Slug not found');
const tour = await getEntry('chessTours', slug);
if (!tour) throw new Error('No chess tour found for this slug');

const { Content } = await render(tour);

const partners = tour.data.partners.length > 0
  ? await getEntries(tour.data.partners)
  : [];

// All tournaments belonging to this chess tour edition.
// ponytail: content order for now. `date` is free French text ("19-23 Octobre
// 2026"), so localeCompare sorted it alphabetically and produced a wrong
// calendar order. Sorting moves into the table itself in the next pass.
const allTournaments = await getCollection(
  'tournaments',
  (t) => t.data.tourEditionSlug === slug
);

// Aggregate scores per player across tournaments
// FIDE ID is the canonical key; fall back to uppercased name
type PlayerRow = {
  name: string;
  scores: (number | null)[];  // one entry per tournament slot, null = did not play
  total: number;
  gender: 'M' | 'F' | null;
};

// FFE category codes end with the player's gender letter (e.g. SenM, U16F)
function genderFromCategory(category?: string): 'M' | 'F' | null {
  const last = category?.trim().slice(-1).toUpperCase();
  return last === 'M' || last === 'F' ? last : null;
}

const playerMap = new Map<string, PlayerRow>();

for (let ti = 0; ti < allTournaments.length; ti++) {
  for (const r of allTournaments[ti].data.results) {
    const key = r.fideId?.trim() || r.name.trim().toUpperCase();
    if (!playerMap.has(key)) {
      playerMap.set(key, {
        name: r.name,
        scores: Array(allTournaments.length).fill(null),
        total: 0,
        gender: null,
      });
    }
    const row = playerMap.get(key)!;
    row.scores[ti] = r.score;
    row.total += r.score;
    // Keep the most recent (last-seen) name spelling and gender
    row.name = r.name;
    row.gender = genderFromCategory(r.category) ?? row.gender;
  }
}

const ranking = [...playerMap.values()].sort(
  (a, b) => b.total - a.total || a.name.localeCompare(b.name)
);

const hasResults = ranking.length > 0;

const topMen = ranking.filter((p) => p.gender === 'M').slice(0, 5);
const topWomen = ranking.filter((p) => p.gender === 'F').slice(0, 5);

// Format score: 7.5 → "7½", 7.0 → "7", etc.
function fmt(score: number | null): string {
  if (score === null) return '—';
  const whole = Math.floor(score);
  return score % 1 === 0.5 ? `${whole}½` : `${whole}`;
}

export async function getStaticPaths() {
  const chessTours = await getCollection('chessTours');
  return chessTours.map((tour) => ({ params: { slug: tour.id } }));
}
---

<Layout title={tour.data.title}>
  <h1 class="tour-title">{tour.data.title}</h1>

  <div class="prose"><Content /></div>
  
  <section class="tournament-section">
    <h2 class="format-heading">Les tournois de cette édition</h2>
    <TournamentTable
      tournaments={allTournaments}
      basePath={`/chess-tours/${slug}`}
      caption="Les tournois de cette édition"
      emptyMessage="Le programme de cette édition n'est pas encore publié."
    />
  </section>
  
  {(topMen.length > 0 || topWomen.length > 0) && (
    <section class="ranking-section top5-section">
      <h2 class="ranking-heading">Classement</h2>
      <div class="top5-grid">
        {topMen.length > 0 && (
          <div class="table-wrapper">
            <h3 class="top5-heading">Top 5 Masculin</h3>
            <table class="ranking-table">
              <thead>
                <tr>
                  <th>#</th>
                  <th class="col-name">Joueur</th>
                  <th class="col-total">Total</th>
                </tr>
              </thead>
              <tbody>
                {topMen.map((player, i) => (
                  <tr class={i % 2 === 0 ? 'row-even' : 'row-odd'}>
                    <td class="col-rank">{i + 1}</td>
                    <td class="col-name">{player.name}</td>
                    <td class="col-total">{fmt(player.total)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
        {topWomen.length > 0 && (
          <div class="table-wrapper">
            <h3 class="top5-heading">Top 5 Féminin</h3>
            <table class="ranking-table">
              <thead>
                <tr>
                  <th>#</th>
                  <th class="col-name">Joueuse</th>
                  <th class="col-total">Total</th>
                </tr>
              </thead>
              <tbody>
                {topWomen.map((player, i) => (
                  <tr class={i % 2 === 0 ? 'row-even' : 'row-odd'}>
                    <td class="col-rank">{i + 1}</td>
                    <td class="col-name">{player.name}</td>
                    <td class="col-total">{fmt(player.total)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>
    </section>
  )}

  {hasResults && (
    <section class="ranking-section">
      <h2 class="ranking-heading">Classement général</h2>
      <div class="table-wrapper">
        <table class="ranking-table">
          <thead>
            <tr>
              <th>#</th>
              <th class="col-name">Joueur</th>
              {allTournaments.map((t) => (
                <th class="col-tournament" title={t.data.name}>{t.data.name}</th>
              ))}
              <th class="col-total">Total</th>
            </tr>
          </thead>
          <tbody>
            {ranking.map((player, i) => (
              <tr class={i % 2 === 0 ? 'row-even' : 'row-odd'}>
                <td class="col-rank">{i + 1}</td>
                <td class="col-name">{player.name}</td>
                {player.scores.map((score) => (
                  <td class="col-score">{fmt(score)}</td>
                ))}
                <td class="col-total">{fmt(player.total)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  {partners.length > 0 && (
    <section class="partners-section">
      <h2 class="format-heading">Les partenaires du Tour</h2>
      <div class="partners-grid">
        {partners.map(({ data: partner }) => {
          const card = (
            <>
              {partner.logo && (
                <img class="partner-logo" src={partner.logo} alt={partner.name} loading="lazy" />
              )}
              <h3 class="partner-name">{partner.name}</h3>
              {partner.description && <p class="partner-desc">{partner.description}</p>}
            </>
          );
          return partner.url ? (
            <a class="partner-card partner-card--link" href={partner.url} target="_blank" rel="noopener">
              {card}
            </a>
          ) : (
            <div class="partner-card">{card}</div>
          );
        })}
      </div>
    </section>
  )}
</Layout>

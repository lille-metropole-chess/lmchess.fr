---
import Layout from '../layouts/Layout.astro';
import { sendContactMessage } from '../lib/contact';

export const prerender = false;

// The form posts to this page rather than to a separate endpoint, so a failed
// send can re-render with what the visitor typed. Redirecting to an API route
// threw the message away, and the error then told them to "try again" on an
// empty form.
let values = { name: '', email: '', message: '' };
let error: string | null = null;

if (Astro.request.method === 'POST') {
	const form = await Astro.request.formData();
	values = {
		name: form.get('name')?.toString().trim() ?? '',
		email: form.get('email')?.toString().trim() ?? '',
		message: form.get('message')?.toString().trim() ?? '',
	};

	if (!values.name || !values.email || !values.message) {
		error = 'Merci de remplir les trois champs avant d\'envoyer.';
	} else {
		const result = await sendContactMessage(values);
		// POST then redirect, so reloading the page does not send twice.
		if (result.ok) return Astro.redirect('/contact?sent=ok', 303);
		error = result.error;
	}
}

const sent = Astro.url.searchParams.get('sent');
---

<Layout title="Contact - Lille Métropole Chess">
	<section class="contact">
		<div class="contact-info">
			<p class="contact-eyebrow">Contact</p>
			<h1>Rejoignez le club</h1>
			<p class="contact-lead">
				Que vous soyez débutant ou joueur confirmé, Lille Métropole Chess vous
				accueille toute l'année. Venez nous rencontrer lors d'une soirée
				portes ouvertes ou écrivez-nous pour plus d'informations.
			</p>
			<dl class="contact-meta">
				<div>
					<dt>Adresse</dt>
					<dd>Salle Camelot, 9 rue de la Halle 59000 LILLE</dd>
				</div>
				<div>
					<dt>Email</dt>
					<dd><a href="mailto:contact@lmchess.fr">contact@lmchess.fr</a></dd>
				</div>
				<div>
					<dt>Horaires</dt>
					<dd>Lun 18h–22h · Sam 14h–18h</dd>
				</div>
			</dl>
		</div>

		<form class="contact-form" method="POST">
			{sent === 'ok' && (
				<p class="contact-status contact-status-ok" role="status">Merci, votre message a bien été envoyé !</p>
			)}
			{error && (
				<p class="contact-status contact-status-error" role="alert">
					{error} Votre message est conservé ci-dessous. Vous pouvez aussi nous écrire à
					<a href="mailto:contact@lmchess.fr">contact@lmchess.fr</a>.
				</p>
			)}

			<p class="contact-form-note">Tous les champs sont obligatoires.</p>

			<div class="contact-field">
				<label for="contact-name">Votre nom</label>
				<input id="contact-name" type="text" name="name" autocomplete="name" value={values.name} required />
			</div>

			<div class="contact-field">
				<label for="contact-email">Votre email</label>
				<input id="contact-email" type="email" name="email" autocomplete="email" value={values.email} required />
			</div>

			<div class="contact-field">
				<label for="contact-message">Votre message</label>
				<textarea id="contact-message" name="message" required>{values.message}</textarea>
			</div>

			<button type="submit" class="contact-submit">
				Envoyer <span aria-hidden="true">→</span>
			</button>
		</form>
	</section>

    <div class="contact-map">
        <iframe title="Carte : Lille Métropole Chess, Salle Camelot, 9 rue de la Halle, Lille" src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2530.0661248633123!2d3.057602477129101!3d50.64446307162985!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47c32a7f3592c48b%3A0xb32009410b035c8c!2sLille%20Metropole%20Chess!5e0!3m2!1sfr!2sfr!4v1786467556772!5m2!1sfr!2sfr" width="600" height="450" allowfullscreen="" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
    </div>
</Layout>

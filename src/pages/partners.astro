---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { assetsIn, resolveAsset } from '../lib/images';

export const prerender = true;

const contentPartners = await getCollection('partners');

const usedLogos = new Set(
  contentPartners
    .map((p) => resolveAsset(p.data.logo)?.src)
    .filter(Boolean)
);

function altFromPath(path: string) {
  return path
    .split('/')
    .pop()!
    .replace(/\.[^.]+$/, '')
    .replace(/[-_.]+/g, ' ')
    .trim();
}

const otherLogos = assetsIn('partners')
  .filter(({ image }) => !usedLogos.has(image.src))
  .map(({ path, image }) => ({ image, alt: altFromPath(path) }))
  .sort((a, b) => a.alt.localeCompare(b.alt, 'fr'));
---

<Layout title="Nos partenaires - Lille Métropole Chess">
  <div class="partners-page">
    <header class="partners-intro">
      <h1>Nos partenaires</h1>
      <p class="partners-lead">
        Le Lille Métropole Chess remercie ses partenaires qui soutiennent le
        club et ses événements tout au long de la saison.
      </p>
    </header>

    {contentPartners.length > 0 && (
      <section class="partners-block">
        <h2 class="partners-block-title">Partenaires officiels</h2>
        <div class="partners-grid">
          {contentPartners.map(({ data: partner }) => {
            const logo = resolveAsset(partner.logo);
            const card = (
              <>
                {logo && (
                  <Image class="partner-logo" src={logo} alt="" width={320} loading="lazy" />
                )}
                <h3 class="partner-name">{partner.name}</h3>
                {partner.description && <p class="partner-desc">{partner.description}</p>}
              </>
            );
            return partner.url ? (
              <a class="partner-card partner-card--link" href={partner.url} target="_blank" rel="noopener">
                {card}
              </a>
            ) : (
              <div class="partner-card">{card}</div>
            );
          })}
        </div>
      </section>
    )}

    {otherLogos.length > 0 && (
      <section class="partners-block">
        <h2 class="partners-block-title">Ils nous soutiennent</h2>
        <ul class="partners-plain-grid">
          {otherLogos.map(({ image, alt }) => (
            <li>
              <Image class="partner-logo-plain" src={image} alt={alt} width={320} loading="lazy" />
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</Layout>

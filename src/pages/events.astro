---
import Layout from '../layouts/Layout.astro'; 
---

<Layout title="Évènements - Lille Métropole Chess">
    <section class="events-section">
        <h1 class="events-title">Évènements</h1>

        <h2>Retrouvez ici tous les évènements organisés par le club, ainsi que les liens vers les tournois et compétitions auxquels nous participons.</h2>

        <ul class="edition-list">
            <li id="tour">
                <a class="edition-link" href="/chess-tours">
                    <span>Lille Métropole Chess Tour</span>
                    <span class="edition-arrow" aria-hidden="true">→</span>
                </a>
            </li>
            <li id="tournaments">
                <a class="edition-link" href="/tournaments">
                    <span>Tournois et compétitions ordinaires</span>
                    <span class="edition-arrow" aria-hidden="true">→</span>
                </a>
            </li>
        </ul>

    </section>

</Layout>

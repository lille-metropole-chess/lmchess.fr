---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import TournamentTable from '../../components/TournamentTable.astro';

export const prerender = true;

// ponytail: content order for now, see the note in chess-tours/[slug].astro.
// Sorting moves into the table itself in the next pass.
const tournaments = await getCollection('tournaments', (t) => !t.data.tourEditionSlug);
---

<Layout title="Tournois et compétitions ordinaires - Lille Métropole Chess">
  <h1>Tournois et compétitions ordinaires</h1>

  <p class="tour-intro">
    Retrouvez ici les tournois et compétitions organisés par le club en dehors du Lille Métropole Chess Tour.
  </p>

  <TournamentTable
    tournaments={tournaments}
    basePath="/tournaments"
    caption="Tournois et compétitions ordinaires"
    emptyMessage="Aucun tournoi hors Chess Tour n'est programmé pour le moment. Les cinq tournois de la saison se trouvent dans le Lille Métropole Chess Tour."
  />
</Layout>

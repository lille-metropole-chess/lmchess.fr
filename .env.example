# Set to "github" on production (main branch / Vercel).
# Leave unset or set to "local" for local development.
KEYSTATIC_STORAGE_KIND=github

# GitHub OAuth App credentials (required when KEYSTATIC_STORAGE_KIND=github).
# Create at: https://github.com/settings/developers → OAuth Apps
# Callback URL: https://your-site.vercel.app/api/keystatic/github/oauth/callback
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=

# Random secret used to sign Keystatic sessions (generate with: openssl rand -hex 32)
KEYSTATIC_SECRET=

# Resend (https://resend.com) API key used by /api/contact to send the contact form emails.
# Requires the sending domain (lmchess.fr) to be verified in Resend.
RESEND_API_KEY=
# Address that receives contact form submissions.
CONTACT_EMAIL_TO=
